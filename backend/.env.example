# Optional overrides for running locally (prefix TPAM_). See docs/DEPLOY.md for a public server.
# TPAM_PORT=8765
# TPAM_DATA_DIR=C:\Users\<you>\AppData\Local\tpam
# TPAM_OPEN_BROWSER=true
# TPAM_API_ID=            # otherwise taken from Windows Credential Manager (set once on first run)
# TPAM_API_HASH=
# TPAM_SECRET_KEY=        # otherwise generated in the data folder (secret.key)
# TPAM_REGISTRATION_OPEN=true
# TPAM_DEV=false          # true only together with `npm run dev` (Vite on :5173)

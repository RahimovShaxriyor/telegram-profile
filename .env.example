# Copy to .env on the server (never commit it). Used by compose.yaml.
TPAM_DOMAIN=tpam.example.com

# Telegram application credentials from https://my.telegram.org → API development tools.
# Users never see them: they sign in with phone + code only.
TPAM_API_ID=
TPAM_API_HASH=

# Encrypts stored Telegram sessions and AI keys. Generate once and KEEP it (losing it = everyone signs in again):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TPAM_SECRET_KEY=

# Optional
TPAM_REGISTRATION_OPEN=true
TPAM_MAX_USERS=200
TPAM_MAX_GUESTS=50
TPAM_LOG_LEVEL=INFO
